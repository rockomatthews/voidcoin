{
  "name": "voidcoin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "genesis:prepare": "node scripts/prepare-genesis.mjs",
    "genesis:predict": "node --env-file=.env.local scripts/predict-deployment.mjs",
    "genesis:publish": "node --env-file=.env.local scripts/publish-genesis.mjs",
    "genesis:verify": "node --env-file=.env.local scripts/verify-genesis.mjs",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts -vvv",
    "contracts:security": "./scripts/security-check.sh",
    "verify": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@openzeppelin/contracts": "^5.4.0",
    "@react-email/components": "^1.0.8",
    "@tanstack/react-query": "^5.90.0",
    "@vercel/blob": "^2.3.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.9.0",
    "sharp": "^0.35.3",
    "viem": "^2.55.13",
    "wagmi": "^3.7.6",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@eslint/eslintrc": "^3.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
