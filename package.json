{
  "name": "voidcoin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "genesis:prepare": "node scripts/prepare-genesis.mjs",
    "genesis:predict": "node --env-file=.env.local scripts/predict-deployment.mjs",
    "genesis:publish": "node --env-file=.env.local scripts/publish-genesis.mjs",
    "genesis:zora:publish": "node --env-file=.env.local scripts/publish-zora-genesis.mjs",
    "genesis:verify": "node --env-file=.env.local scripts/verify-genesis.mjs",
    "b20:predict": "node --env-file=.env.local scripts/predict-b20-v4.mjs",
    "b20:publish": "node --env-file=.env.local scripts/publish-b20-genesis.mjs",
    "b20:verify": "node --env-file=.env.local scripts/verify-b20-genesis.mjs",
    "b20:surface:verify": "node --env-file=.env.local scripts/verify-b20-surface-readiness.mjs",
    "b20:surface:test": "node scripts/surface-readiness-harness.mjs",
    "b20:auction:prepare": "node --env-file=.env.local tools/uniswap-launch/prepare.mjs",
    "b20:auction:simulate": "node tools/uniswap-launch/simulate-safe.mjs",
    "hood:launch:prepare": "node --env-file=.env.local tools/hood-launch/prepare.mjs",
    "hood:bootstrap:publish": "node --env-file=.env.local scripts/publish-hood-bootstrap.mjs",
    "hood:final:publish": "node --env-file=.env.local scripts/publish-hood-final.mjs",
    "hood:surface:verify": "node --env-file=.env.local scripts/verify-hood-surface-readiness.mjs",
    "hood:socials:test": "node scripts/hood-socials-validator-harness.mjs",
    "hood:safe:prepare": "node --env-file-if-exists=.env.local tools/hood-launch/prepare-safe-replay.mjs",
    "hood:controller:handoff": "node --env-file=.env.local tools/hood-launch/prepare-controller-handoff.mjs",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts -vvv",
    "contracts:security": "./scripts/security-check.sh",
    "verify": "npm run lint && npm test && npm run b20:surface:test && npm run hood:socials:test && npm run build"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "^4.3.7",
    "@neondatabase/serverless": "^1.0.2",
    "@openzeppelin/contracts": "^5.4.0",
    "@react-email/components": "^1.0.8",
    "@tanstack/react-query": "^5.90.0",
    "@vercel/blob": "^2.3.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.9.0",
    "viem": "^2.55.13",
    "wagmi": "^3.7.6",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@eslint/eslintrc": "^3.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "blockstore-core": "^7.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "ipfs-unixfs-importer": "^17.0.1",
    "multiformats": "^14.0.5",
    "sharp": "^0.35.3",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
